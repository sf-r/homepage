{
  // Cloudflare Workers 설정.
  // name은 Cloudflare 대시보드의 Worker 이름과 같아야 합니다.
  "name": "homepage",
  "compatibility_date": "2026-10-06",
  // 대부분은 정적 파일(saffron/)을 그대로 내보내고,
  // run_worker_first에 적힌 경로만 src/worker.js가 먼저 검사합니다 (아카라이브 전용 미리보기).
  "main": "src/worker.js",
  "assets": {
    "directory": "./saffron",
    "binding": "ASSETS",
    "run_worker_first": ["/pages/rebloom/gallery", "/pages/rebloom/gallery/*"]
  }
}
